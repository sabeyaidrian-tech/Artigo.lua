local function makeSideButton(order, label, onClick)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(65, 20)
	b.Position = UDim2.fromOffset(0, order * 24) 
	b.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	b.BorderSizePixel = 0
	b.Text = ""
	b.AutoButtonColor = false
	b.Parent = sideHolder
	local s = Instance.new("UIStroke") s.Color = Color3.fromRGB(255, 85, 0) s.Thickness = 1.5 s.Parent = b
	local tx = Instance.new("TextLabel") tx.Size = UDim2.fromScale(1, 1) tx.BackgroundTransparency = 1 tx.Text = label tx.TextSize = 11 tx.Font = Enum.Font.GothamBold tx.TextColor3 = Color3.fromRGB(255, 255, 255) tx.Parent = b
	b.MouseButton1Click:Connect(onClick)
	return b, tx
end


    local val = Instance.new("TextLabel") val.Size = UDim2.new(0.3, -10, 1, 0) val.Position = UDim2.new(0.7, 0, 0, 0) val.BackgroundTransparency = 1 val.Text = valueText val.TextColor3 = Color3.fromRGB(100, 200, 255) val.Font = Enum.Font.GothamBold val.TextSize = 13 val.TextXAlignment = Enum.TextXAlignment.Right val.Parent = holder
end

local function createScroll(parent)
    local sf = Instance.new("ScrollingFrame")
    sf.Size = UDim2.fromScale(1, 1)
    sf.BackgroundTransparency = 1
    sf.BorderSizePixel = 0
    sf.ScrollBarThickness = 2
    sf.ScrollBarImageColor3 = Color3.fromRGB(100, 150, 255)
    sf.CanvasSize = UDim2.new(0, 0, 0, 0)
    sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
    sf.Parent = parent
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6) 
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = sf
    return sf
end


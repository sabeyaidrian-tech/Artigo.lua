local function addEvadeNotification(msgText)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 36)
    card.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    card.BackgroundTransparency = 0
    card.BorderSizePixel = 0
    card.Parent = notifyHolder
    
    local cCorner = Instance.new("UICorner") cCorner.CornerRadius = UDim.new(0, 6) cCorner.Parent = card
    local cStroke = Instance.new("UIStroke") cStroke.Color = Color3.fromRGB(50, 50, 65) cStroke.Thickness = 1 cStroke.Parent = card
    
    local sideLine = Instance.new("Frame")
    sideLine.Size = UDim2.fromOffset(3, 24)
    sideLine.Position = UDim2.new(0, 6, 0.5, -12)
    sideLine.BackgroundColor3 = Color3.fromRGB(255, 85, 0)
    sideLine.BorderSizePixel = 0
    sideLine.Parent = card
    local slCorner = Instance.new("UICorner") slCorner.CornerRadius = UDim.new(1, 0) slCorner.Parent = sideLine

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -18, 1, 0)
    lbl.Position = UDim2.fromOffset(14, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = msgText or "Prediction"
    lbl.TextColor3 = Color3.fromRGB(240, 240, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = card
    
    task.spawn(function()
        task.wait(1.5)
        for i = 1, 15 do
            local alpha = i / 15
            card.BackgroundTransparency = alpha
            cStroke.Transparency = alpha
            sideLine.BackgroundTransparency = alpha
            lbl.TextTransparency = alpha
            task.wait(0.04)
        end
        card:Destroy()
    end)
end


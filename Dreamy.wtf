local selectedConfigName = nil

local function refreshConfigList()
    for _, child in ipairs(cfgListContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local files = {}
    pcall(function()
        if type(listfiles) == "function" then
            for _, file in ipairs(listfiles(CONFIG_DIR)) do
                if string.sub(file, -5) == ".json" then
                    local name = file:match("([^/\\]+)%.json$")
                    if name then table.insert(files, name) end
                end
            end
        end
    end)
    if #files == 0 then
        local emptyLbl = Instance.new("TextLabel")
        emptyLbl.Size = UDim2.new(1, 0, 0, 40)
        emptyLbl.BackgroundTransparency = 1
        emptyLbl.Text = "No saved configs found."
        emptyLbl.TextColor3 = Color3.fromRGB(120, 120, 130)
        emptyLbl.Font = Enum.Font.Gotham
        emptyLbl.TextSize = 12
        emptyLbl.Parent = cfgListContainer
        return
    end
    for _, cfgName in ipairs(files) do
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 0, 42)
        card.BackgroundColor3 = (selectedConfigName == cfgName) and Color3.fromRGB(30, 25, 20) or Color3.fromRGB(18, 18, 24)
        card.BorderSizePixel = 0
        card.Parent = cfgListContainer
        local cCorner = Instance.new("UICorner") cCorner.CornerRadius = UDim.new(0, 6) cCorner.Parent = card
        local cStroke = Instance.new("UIStroke") cStroke.Color = (selectedConfigName == cfgName) and Color3.fromRGB(255, 85, 0) or Color3.fromRGB(40, 40, 50) cStroke.Thickness = 1 cStroke.Parent = card
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -160, 1, 0)
        label.Position = UDim2.fromOffset(12, 0)
        label.BackgroundTransparency = 1
        label.Text = cfgName
        label.TextColor3 = Color3.fromRGB(230, 230, 240)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = card
        
        local loadCardBtn = Instance.new("TextButton")
        loadCardBtn.Size = UDim2.fromOffset(65, 26)
        loadCardBtn.Position = UDim2.new(1, -145, 0.5, -13)
        loadCardBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
        loadCardBtn.Text = "Load"
        loadCardBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        loadCardBtn.Font = Enum.Font.GothamBold
        loadCardBtn.TextSize = 11
        loadCardBtn.Parent = card
        local lcbC = Instance.new("UICorner") lcbC.CornerRadius = UDim.new(0, 4) lcbC.Parent = loadCardBtn
        
        local delCardBtn = Instance.new("TextButton")
        delCardBtn.Size = UDim2.fromOffset(65, 26)
        delCardBtn.Position = UDim2.new(1, -72, 0.5, -13)
        delCardBtn.BackgroundColor3 = Color3.fromRGB(160, 45, 45)
        delCardBtn.Text = "Delete"
        delCardBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delCardBtn.Font = Enum.Font.GothamBold
        delCardBtn.TextSize = 11
        delCardBtn.Parent = card
        local dcbC = Instance.new("UICorner") dcbC.CornerRadius = UDim.new(0, 4) dcbC.Parent = delCardBtn
        
        card.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                selectedConfigName = cfgName
                refreshConfigList()
            end
        end)
        
        loadCardBtn.MouseButton1Click:Connect(function()
            pcall(function()
                if type(readfile) == "function" and type(isfile) == "function" then
                    local path = CONFIG_DIR .. "/" .. cfgName .. ".json"
                    if isfile(path) then
                        local data = HttpService:JSONDecode(readfile(path))
                        for k, v in pairs(data) do 
                            if Settings[k] ~= nil then 
                                Settings[k] = v 
                            end 
                        end
                        Settings.CurrentConfig = cfgName
                        
                        if Settings.UndergroundEnabled then startUnderground() else stopUnderground() end
                        if Settings.VoidEnabled then startVoid() else stopVoid() end
                        if Settings.OrbitEnabled then startOrbit() else stopOrbit() end
                        if Settings.SlingEnabled then startSling() else stopSling() end

                        loadCardBtn.Text = "Loaded!"
                        task.delay(1, function() loadCardBtn.Text = "Load" end)
                    end
                end
            end)
        end)
        
        delCardBtn.MouseButton1Click:Connect(function()
            pcall(function()
                if type(delfile) == "function" then
                    delfile(CONFIG_DIR .. "/" .. cfgName .. ".json")
                    if selectedConfigName == cfgName then selectedConfigName = nil end
                    refreshConfigList()
                end
            end)
        end)
    end
end

saveBtn.MouseButton1Click:Connect(function()
    local name = nameBox.Text
    if name ~= "" and type(writefile) == "function" then
        writefile(CONFIG_DIR .. "/" .. name .. ".json", HttpService:JSONEncode(Settings))
        selectedConfigName = name
        nameBox.Text = ""
        refreshConfigList()
    end
end)

task.defer(refreshConfigList)


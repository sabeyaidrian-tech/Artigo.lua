local function selectTab(index)
	activeTab = index
	for i, btn in ipairs(tabButtons) do
		btn.BackgroundColor3 = (i == index) and Color3.fromRGB(30, 30, 40) or Color3.fromRGB(10, 10, 10)
		btn.TextColor3 = (i == index) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 170)
	end
	for i, content in ipairs(tabContents) do content.Visible = (i == index) end
	if tabs[index].Mode == MODE_UE or tabs[index].Mode == MODE_KICIA or tabs[index].Mode == MODE_SOLIX then
		Settings.CtrMode = tabs[index].Mode
	end
end

for i, t in ipairs(tabs) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 28)
	btn.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	btn.Text = "   " .. t.Name
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.TextColor3 = Color3.fromRGB(150, 150, 170)
	btn.AutoButtonColor = false
	btn.Parent = tabList
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 6) c.Parent = btn
	table.insert(tabButtons, btn)
	btn.MouseButton1Click:Connect(function() selectTab(i) end)
    
	local content = Instance.new("Frame")
    content.Size = UDim2.fromScale(1, 1)
    content.BackgroundTransparency = 1
    content.Visible = false
    content.Parent = contentHolder
	table.insert(tabContents, content)
end

local function makeToggleRow(parent, labelText, onToggle)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 36)
	btn.BackgroundColor3 = Color3.fromRGB(20, 20, 25) 
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.Parent = parent
    
	local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 6) c.Parent = btn
	local s = Instance.new("UIStroke") s.Color = Color3.fromRGB(40, 40, 50) s.Parent = btn
    
	local txt = Instance.new("TextLabel") txt.Size = UDim2.new(0.7, -10, 1, 0) txt.Position = UDim2.new(0, 12, 0, 0) txt.BackgroundTransparency = 1 txt.Text = labelText txt.TextColor3 = Color3.fromRGB(220, 220, 230) txt.Font = Enum.Font.GothamMedium txt.TextSize = 13 txt.TextXAlignment = Enum.TextXAlignment.Left txt.Parent = btn
    
    local pill = Instance.new("Frame") pill.Size = UDim2.fromOffset(36, 20) pill.Position = UDim2.new(1, -48, 0.5, -10) pill.BackgroundColor3 = Color3.fromRGB(30, 30, 35) pill.Parent = btn
    local pc = Instance.new("UICorner") pc.CornerRadius = UDim.new(1, 0) pc.Parent = pill
    
    local knob = Instance.new("Frame") knob.Size = UDim2.fromOffset(14, 14) knob.Position = UDim2.new(0, 3, 0.5, -7) knob.BackgroundColor3 = Color3.fromRGB(150, 150, 150) knob.Parent = pill
    local kc = Instance.new("UICorner") kc.CornerRadius = UDim.new(1, 0) kc.Parent = knob

	btn.MouseButton1Click:Connect(function()
		local isOn = onToggle()
		if isOn then
            TweenService:Create(pill, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 200, 100)}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 19, 0.5, -7), BackgroundColor3 = Color3.fromRGB(255,255,255)}):Play()
            s.Color = Color3.fromRGB(60, 200, 100)
		else
            TweenService:Create(pill, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 35)}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Color3.fromRGB(150, 150, 150)}):Play()
            s.Color = Color3.fromRGB(40, 40, 50)
		end
	end)
end

local function makeDropdownRow(parent, labelText, options, onSelect)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = parent
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 6) c.Parent = btn
    local txt = Instance.new("TextLabel") txt.Size = UDim2.new(0.5, -10, 1, 0) txt.Position = UDim2.new(0, 12, 0, 0) txt.BackgroundTransparency = 1 txt.Text = labelText txt.TextColor3 = Color3.fromRGB(220, 220, 230) txt.Font = Enum.Font.GothamMedium txt.TextSize = 13 txt.TextXAlignment = Enum.TextXAlignment.Left txt.Parent = btn
    local val = Instance.new("TextLabel") val.Size = UDim2.new(0.5, -10, 1, 0) val.Position = UDim2.new(0.5, 0, 0, 0) val.BackgroundTransparency = 1 val.Text = options[1] val.TextColor3 = Color3.fromRGB(100, 200, 255) val.Font = Enum.Font.GothamBold val.TextSize = 13 val.TextXAlignment = Enum.TextXAlignment.Right val.Parent = btn
    local currentIdx = 1
    btn.MouseButton1Click:Connect(function()
        currentIdx = currentIdx + 1
        if currentIdx > #options then currentIdx = 1 end
        val.Text = options[currentIdx]
        onSelect(options[currentIdx])
    end)
end


local frozenCFrame = nil
local lastEvadeNotify = 0
local activeProjectileBypassObjects = {}

function startUnderground()
    killConn("underground")
    frozenCFrame = nil
    if not root or not root.Parent then return end
    pcall(function()
        local currentPos = root.Position
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = { char }
        local hit = workspace:Raycast(currentPos + Vector3.new(0, 5, 0), Vector3.new(0, -30, 0), rayParams)
        local floorY = hit and hit.Position.Y or currentPos.Y
        local depthY = floorY - Settings.UndergroundDepth
        local lookV = root.CFrame.LookVector
        frozenCFrame = CFrame.lookAt(Vector3.new(currentPos.X, depthY, currentPos.Z), Vector3.new(currentPos.X + lookV.X, depthY, currentPos.Z + lookV.Z))
        root.CFrame = frozenCFrame
        root.Anchored = true
    end)
    conns.underground = RunService.Heartbeat:Connect(function()
        if not Settings.UndergroundEnabled or not root or not root.Parent then
            stopUnderground()
            return
        end
        pcall(function()
            if frozenCFrame then
                root.Anchored = true
                root.CFrame = frozenCFrame
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end)
end

function stopUnderground() 
    killConn("underground") 
    frozenCFrame = nil
    if root and root.Parent then
        pcall(function() root.Anchored = false end)
    end
end

local voidElapsed, voidPos, voidDriftDir, voidBasePos = 0, Vector3.new(0, Settings.VoidBaseAlt, 0), Vector3.new(1, 0, 0).Unit, Vector3.new(0, Settings.VoidBaseAlt, 0)

local function stepVoidDrift(dt)
    local m = Settings.VoidMethod
    if m == "Drift" then
        local nx, ny, nz, amp, freq = 0, 0, 0, 1, 0.0001
        for i=1,4 do nx = nx + math.noise(voidElapsed*freq, 0, 0)*amp; ny = ny + math.noise(0, voidElapsed*freq, 0)*amp; nz = nz + math.noise(0, 0, voidElapsed*freq)*amp; freq = freq*2.37; amp = amp*0.5 end
        local len = math.sqrt(nx*nx + ny*ny + nz*nz)
        if len < 0.001 then return 1, 0, 0 end
        local dx, dy, dz = nx/len, ny/len, nz/len
        voidDriftDir = voidDriftDir:Lerp(Vector3.new(dx, dy, dz).Unit, Settings.VoidChaos * dt * 10)
        voidPos = voidPos + voidDriftDir * Settings.VoidSpeed * dt
        if (voidPos - voidBasePos).Magnitude > Settings.VoidRadius then voidPos = voidBasePos + (voidPos - voidBasePos).Unit * Settings.VoidRadius; voidDriftDir = -voidDriftDir end
        return voidPos
    elseif m == "Chaos" then
        voidPos = voidPos + Vector3.new((math.random()-0.5)*Settings.VoidSpeed*dt*5, (math.random()-0.5)*Settings.VoidSpeed*dt*5, (math.random()-0.5)*Settings.VoidSpeed*dt*5)
        if (voidPos - voidBasePos).Magnitude > Settings.VoidRadius then voidPos = voidBasePos + (voidPos - voidBasePos).Unit * Settings.VoidRadius end
        return voidPos
    elseif m == "Quantum" then
        local r = Settings.VoidRadius * (math.random()>0.5 and 1 or -1)
        return voidBasePos + Vector3.new(r, (math.random()-0.5)*Settings.VoidRadius*0.2, r) + Vector3.new((math.random()-0.5)*Settings.VoidRadius, 0, (math.random()-0.5)*Settings.VoidRadius)
    end
    return voidPos
end

local function scanAndBypassProjectiles()
    if not Settings.ProjectileBypassEnabled or not root then return end
    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not activeProjectileBypassObjects[obj] then
                local nameL = obj.Name:lower()
                if nameL:find("bullet") or nameL:find("projectile") or nameL:find("rocket") or nameL:find("missile") or nameL:find("beam") or nameL:find("pellet") then
                    local dist = (obj.Position - root.Position).Magnitude
                    if dist < 65 and obj.AssemblyLinearVelocity.Magnitude > 30 then
                        activeProjectileBypassObjects[obj] = true
                        local evasionShift = Vector3.new(math.random(-12, 12), math.random(6, 16), math.random(-12, 12))
                        root.CFrame = root.CFrame + evasionShift
                        if tick() - lastEvadeNotify >= 0.7 then
                            lastEvadeNotify = tick()
                            addEvadeNotification("Prediction: Evasion Shift")
                        end
                    end
                end
            end
        end
    end)
end

local function lockToVoid(dt)
    local intendedVoidPos = stepVoidDrift(dt)
    local hrp = root
    if not hrp or not hrp.Parent then return end
    
    if Settings.ProjectileBypassEnabled then
        scanAndBypassProjectiles()
    end

    if Settings.PredictionEnabled then
        local target = getClosest()
        if target and target.Character then
            local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local vel = tHrp.AssemblyLinearVelocity
                local dist = (tHrp.Position - hrp.Position).Magnitude
                if vel.Magnitude > 2 or dist < 50 then
                    local angleOffset = math.sin(tick() * 10) * 12
                    local dodgeShift = Vector3.new(-vel.Z * 0.15 + angleOffset, math.random(2, 8), vel.X * 0.15 + angleOffset)
                    intendedVoidPos = intendedVoidPos + dodgeShift
                    if tick() - lastEvadeNotify >= 0.8 then
                        lastEvadeNotify = tick()
                        addEvadeNotification("Prediction: Evasion Shift (" .. target.Name .. ")")
                    end
                end
            end
        end
    end
    pcall(function() 
        hrp.CFrame = CFrame.new(intendedVoidPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero 
    end)
end

function startVoid()
    killConn("void")
    posGui.Enabled = true
    if root then
        voidPos = Vector3.new(root.Position.X, Settings.VoidBaseAlt, root.Position.Z)
        voidBasePos = Vector3.new(0, Settings.VoidBaseAlt, 0)
    end
    conns.void = RunService.Heartbeat:Connect(function(dt)
        if not Settings.VoidEnabled then 
            killConn("void")
            posGui.Enabled = false
            return 
        end
        voidElapsed = voidElapsed + dt
        pcall(lockToVoid, dt)
        if root and root.Parent then
            local pos = root.Position
            xVal.Text = string.format("%.2f", pos.X)
            yVal.Text = string.format("%.2f", pos.Y)
            zVal.Text = string.format("%.2f", pos.Z)
        end
    end)
end

function stopVoid() 
    killConn("void") 
    posGui.Enabled = false
end

local orbitAngle, orbitLocalElapsed, orbitCurrentRadius = 0, 0, 0
function startOrbit()
    killConn("orbit")
    orbitAngle = 0
    orbitLocalElapsed = 0
    orbitCurrentRadius = Settings.OrbitDist
    conns.orbit = RunService.Heartbeat:Connect(function(dt)
        if not Settings.OrbitEnabled or not root or not root.Parent then 
            if not Settings.OrbitEnabled then killConn("orbit") end
            return 
        end
        local target = getClosest()
        if not target or not target.Character then return end
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local targetPos = hrp.Position
        orbitAngle = orbitAngle + math.rad(Settings.OrbitSpeed) * dt
        orbitLocalElapsed = orbitLocalElapsed + dt
        local r = Settings.OrbitDist
        local h = Settings.OrbitHeight
        local x, y, z = 0, 0, 0
        if Settings.OrbitMode == "Circle" then
            x = math.cos(orbitAngle) * r; z = math.sin(orbitAngle) * r; y = h
        elseif Settings.OrbitMode == "Figure 8" then
            x = math.sin(orbitAngle) * r; z = math.sin(orbitAngle) * math.cos(orbitAngle) * r * 0.7; y = h
        end
        local dst = targetPos + Vector3.new(x, y, z)
        local smooth = root.Position:Lerp(dst, Settings.OrbitLerp)
        pcall(function()
            root.CFrame = CFrame.new(smooth)
            root.AssemblyLinearVelocity = Vector3.zero
        end)
    end)
end
function stopOrbit() killConn("orbit") end

local slingTargetPos = CFrame.new(9000, 9000, 9000)
local slingProjectiles = {}

function startSling()
    killConn("sling")
    local childAddedConn = workspace.ChildAdded:Connect(function(o)
        if not Settings.SlingEnabled then return end
        if not o:IsA("BasePart") then return end
        if o.Name == "CoreProjectile" then 
            slingProjectiles[o] = true 
        elseif o.Name == "Part" then 
            task.defer(function()
                if o and o.Parent and o.AssemblyLinearVelocity.Magnitude > 50 then 
                    slingProjectiles[o] = true 
                end
            end) 
        end
    end)
    local childRemovedConn = workspace.ChildRemoved:Connect(function(o) 
        slingProjectiles[o] = nil 
    end)
    conns.sling = RunService.Heartbeat:Connect(function()
        if not Settings.SlingEnabled then 
            killConn("sling")
            childAddedConn:Disconnect()
            childRemovedConn:Disconnect()
            slingProjectiles = {}
            return 
        end
        pcall(function()
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    local h = p.Character:FindFirstChild("HumanoidRootPart")
                    if h then 
                        h.CFrame = slingTargetPos 
                        h.AssemblyLinearVelocity = Vector3.zero 
                        h.AssemblyAngularVelocity = Vector3.zero 
                    end
                end 
            end
        end)
    end)
end
function stopSling() killConn("sling") end


local snowParticles = {}
for i = 1, 150 do
	local p = Instance.new("Frame")
	local size = math.random(3, 8)
	p.Size = UDim2.fromOffset(size, size)
	p.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	p.BackgroundTransparency = math.random(10, 50) / 100
	p.BorderSizePixel = 0
	p.Position = UDim2.new(math.random(), 0, math.random(), 0)
	local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1, 0) c.Parent = p
	p.Parent = snowGui
	table.insert(snowParticles, { Frame = p, SpeedX = math.random(-150, 150) / 1000, SpeedY = math.random(250, 500) / 1000 })
end

RunService.RenderStepped:Connect(function(dt)
	if not snowGui.Enabled then return end
	for _, p in ipairs(snowParticles) do
		local f = p.Frame
		f.Position = f.Position + UDim2.new(p.SpeedX * dt, 0, p.SpeedY * dt, 0)
		if f.Position.Y.Scale > 1 then f.Position = UDim2.new(math.random(), 0, -0.05, 0) end
	end
end)


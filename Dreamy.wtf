applyFflagBtn.MouseButton1Click:Connect(function()
    local rawJson = fflagBox.Text
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(rawJson)
    end)
    if success and type(decoded) == "table" then
        pcall(function()
            if type(writefile) == "function" then
                writefile(FFLAG_FILE, rawJson)
            end
        end)
        pcall(function()
            for flagName, flagVal in pairs(decoded) do
                if type(setfflag) == "function" then
                    pcall(setfflag, flagName, tostring(flagVal))
                end
            end
        end)
        applyFflagBtn.Text = "Successfully Applied & Saved!"
        applyFflagBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 80)
        task.delay(2, function()
            applyFflagBtn.Text = "Apply & Save FFlags"
            applyFflagBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
        end)
    else
        applyFflagBtn.Text = "Invalid JSON Format!"
        applyFflagBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        task.delay(2, function()
            applyFflagBtn.Text = "Apply & Save FFlags"
            applyFflagBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
        end)
    end
end)

